# Docker Compose project name
COMPOSE_PROJECT_NAME=iot_smart_classroom_edge
# Host address for MQTT broker
MQTT_BROKER_HOST=host.docker.internal
# Unique ID of this classroom
ROOM_ID=classroom_test

# Enable or disable camera usage
HAS_CAMERA=true
# Mode for sensors: fake/simulated or real
SENSOR_MODE=fake
# Mode for camera: fake or real
CAM_MODE=fake
# Target/default occupants in the room
OCCUPANTS=30

# Time the camera remains active (seconds)
CAMERA_ACTIVE_SECONDS=30
# Time the camera sleeps (seconds)
CAMERA_SLEEP_SECONDS=60

# Timeout (seconds) before considering room empty
MOTION_SENSOR_TIMEOUT=300

# Duration (seconds) manual override settings are held
MANUAL_MODE_HOLD_SECONDS=60
# Force unbuffered stdout/stderr for Python logs
PYTHONUNBUFFERED=1

# Preset temperature generation mode
TEMP_MODE=high
# Daily start hour for simulated motion
MOTION_START_HOUR=23
# Daily end hour for simulated motion
MOTION_END_HOUR=1

# Dynamic evaluation intervals (seconds)
# When motion is active (<10s ago)
EVAL_INTERVAL_FAST=1
# When room is recently idle (10-60s)
EVAL_INTERVAL_MEDIUM=3
# When room is empty (>60s)
EVAL_INTERVAL_SLOW=10
# Run AC on HIGH fan speed when occupancy exceeds this threshold
OCCUPANCY_HIGH_THRESHOLD=20

# Default comfort temperature (°C)
THRESHOLD_BASE=21.0
# Default deadband (°C) to prevent rapid cycling
HOLDUP_BAND=1.5

# Default cooling temperature setpoint for pre-cooling (°C)
DEFAULT_AC_PRECOOL_TEMP=21
# URL of the central service registry/catalog
CATALOG_URL=http://host.docker.internal:9090
