# Docker Compose project name
COMPOSE_PROJECT_NAME=iot_smart_classroom_center

# Host address for MQTT broker
MQTT_BROKER=mqtt-broker

# Force unbuffered stdout/stderr for Python logs
PYTHONUNBUFFERED=1

# Target city name for fetching current weather
WEATHER_CITY=Torino

# Telegram Bot access token
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenWeatherMap API access token
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default cooling temperature setpoint for pre-cooling (°C)
DEFAULT_AC_PRECOOL_TEMP=21

# Duration (seconds) manual override settings are held
MANUAL_HOLD_THRESHOLD=60

# Sensitivity factor for HVAC efficiency calculations
EFFICIENCY_SENSITIVITY=10.0

# Interval in seconds for updating system metrics
UPDATE_METRICS_INTERVAL_SECONDS=300

# Maximum age in seconds for sensor data to be considered fresh
FRESH_DATA_MAX_AGE_SECONDS=30
